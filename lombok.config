# Configuração Global do Lombok

# Ativa anotações de processamento
config.stopBubbling = true

# Lombok SLF4J - Usar @Slf4j para logging
lombok.log.fieldName = log
lombok.log.fieldIsStatic = true

# Anotação Builder - Padrão
lombok.builder.flagUsage = warning

# Data - Combina @Getter, @Setter, @ToString, @EqualsAndHashCode, @RequiredArgsConstructor
lombok.data.flagUsage = warning

# ToString - Excluir campos grandes/sensíveis
lombok.toString.includeFieldNames = true
lombok.toString.doNotUseGetters = false

# EqualsAndHashCode
lombok.equalsAndHashCode.doNotUseGetters = false
lombok.equalsAndHashCode.callSuper = WARN

# Accessors
lombok.accessors.chain = false
lombok.accessors.fluent = false

# Setter
lombok.setter.flagUsage = warning

# Value - Immutable version of @Data
lombok.value.flagUsage = warning

